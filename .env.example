# Token bot dari discord.com/developers > your app > Bot > Reset Token
DISCORD_TOKEN=

# ID server tempat bot dipakai (Developer Mode aktif, lalu klik kanan server > Copy ID).
# Command didaftarkan ke guild ini, jadi langsung aktif tanpa nunggu propagasi global.
DISCORD_GUILD_ID=

# ID channel tempat katalog role ditampilkan dan user memilon sendiri lewat select menu
RULES_ROLES_CHANNEL_ID=

# Port HTTP untuk UptimeRobot
PORT=3000

# Override lokasi file data (default: ./data.json)
# DATA_FILE=
